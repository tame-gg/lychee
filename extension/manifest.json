{
  "manifest_version": 3,
  "name": "Download with Lychee",
  "short_name": "Lychee",
  "version": "0.1.2",
  "description": "Send downloads from your browser to Lychee Download Manager.",
  "homepage_url": "https://tame.gg/projects/lychee",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Lychee",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "permissions": ["alarms", "downloads", "contextMenus", "cookies", "storage", "tabs"],
  "host_permissions": ["<all_urls>"]
}
